# ال کافه — static site. Apache/LiteSpeed shared hosting.

# One public origin. HTTP, www, retired domains and hosting aliases are redirected
# to the HTTPS apex so the same page is not published under multiple addresses. The
# <link rel=canonical> in each page keeps search engines pointed at one of them
# and does nothing for the visitor: over plaintext the phone number and the map
# link travel unencrypted and the browser labels the page "not secure".
#
# Two conditions, not one. Some shared hosts terminate TLS at a proxy and hand
# the request to Apache with %{HTTPS} unset, where a scheme-only test redirects
# an already-secure request back to itself forever. If the proxy says it was
# https, believe it and stop. Deliberately no HSTS: a redirect loop is a bad
# hour, a redirect loop pinned into every visitor's browser is a bad month.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://l-cafe.ir%{REQUEST_URI} [R=301,L]

  # Canonical host: redirect www, the retired domain, and any hosting alias
  # to the public apex domain.
  RewriteCond %{HTTP_HOST} !^l-cafe\.ir$ [NC]
  RewriteRule ^ https://l-cafe.ir%{REQUEST_URI} [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

DirectoryIndex index.html

# The site ships no directory listings.
Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Menu/landing images keep stable filenames and may be replaced in place.
  # Force revalidation so returning visitors cannot be pinned to an old photo.
  ExpiresByType image/webp "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 0 seconds"
  ExpiresByType image/png "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Stable-name images may change on any deploy. no-cache still permits a local
  # copy, but requires validation before it is reused.
  <FilesMatch "\.(?:webp|svg|png)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Vite-generated files carry a content hash. They cannot change in place and
  # are safe to cache immutably; this later rule overrides the generic image
  # policy for hashed SVG/PNG output as well.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(?:css|js|svg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Legacy stable-name helper, if served by an older host layout, must also
# revalidate rather than being pinned in a browser cache.
<FilesMatch "^image-slot\.js$">
  <IfModule mod_expires.c>
    ExpiresByType application/javascript "access plus 0 seconds"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# image-slot.js fetches this on every page load; without an explicit type some
# hosts serve dotfiles as octet-stream.
<Files ".image-slots.state.json">
  ForceType application/json
</Files>
