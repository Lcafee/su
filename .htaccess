# ال کافه — site delivery and menu-admin API. Apache/LiteSpeed shared hosting.

# One origin. The certificate covers the apex, www and mail, and both hostnames
# resolve, so without this the same page answers on four addresses. The
# <link rel=canonical> in each page keeps search engines pointed at one of them
# and does nothing for the visitor: over plaintext the phone number and the map
# link travel unencrypted and the browser labels the page "not secure".
#
# Two conditions, not one. Some shared hosts terminate TLS at a proxy and hand
# the request to Apache with %{HTTPS} unset, where a scheme-only test redirects
# an already-secure request back to itself forever. If the proxy says it was
# https, believe it and stop. Deliberately no HSTS: a redirect loop is a bad
# hour, a redirect loop pinned into every visitor's browser is a bad month.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://l-cafe.ir%{REQUEST_URI} [R=301,L]

  # Canonical host: redirect www and hosting aliases to the public apex domain.
  RewriteCond %{HTTP_HOST} !^l-cafe\.ir$ [NC]
  RewriteRule ^ https://l-cafe.ir%{REQUEST_URI} [R=301,L]

  # Persistent menu state is data, never executable content. Temporary publish
  # names are not public API surface; current and previous are the two public
  # static recovery pointers used by the menu runtime.
  RewriteRule ^managed-(?:menu|media)/\. - [F,L,NC]
  RewriteRule ^managed-(?:menu|media)/.*\.(?:php|phtml|phar|cgi|pl)$ - [F,L,NC]
</IfModule>

ErrorDocument 404 /404.html

DirectoryIndex index.html

# The site ships no directory listings.
Options -Indexes

# LCAFE-DEPLOY-STAGING-DENY
# deploy.py temporarily uploads changed files beside their live destination.
# Those verified-but-not-yet-promoted files must never be retrievable over HTTP.
<FilesMatch "\.lcafe-uploading$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Menu/landing images keep stable filenames and may be replaced in place.
  # Force revalidation so returning visitors cannot be pinned to an old photo.
  ExpiresByType image/webp "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 0 seconds"
  ExpiresByType image/png "access plus 0 seconds"
  # Font filenames are stable and can be replaced in place, so they must
  # revalidate just like stable-name images. Hashed WOFF2 files are overridden
  # by the immutable rule below.
  ExpiresByType font/woff2 "access plus 0 seconds"
  # Stable-name CSS/JS can also be replaced in place. Vite's hashed output is
  # overridden by the immutable rule below, so the safe default is revalidation.
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Stable-name public files may change on any deploy. Keep a local copy if the
  # browser wants one, but require validation before it is reused. This includes
  # HTML, robots/sitemap, copied font CSS, media and any stable helper JS.
  <FilesMatch "\.(?:html|css|js|json|xml|txt|webp|svg|png|woff2)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Vite-generated files use the current eight-character content hash immediately
  # before the extension. Match exactly that shape: {8,} can accidentally classify
  # descriptive stable names such as l-cafe-pattern-inverted-tight.svg as immutable.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(?:css|js|svg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Stable current/previous snapshots revalidate on every navigation; matching
  # ETags let unchanged visits complete as 304. Managed renditions are
  # content-addressed.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/managed-menu/(?:current|previous)\.json$" lcafe_managed_menu
    SetEnvIf Request_URI "^/managed-media/[a-f0-9]{64}-(?:300|600)\.webp$" lcafe_managed_media
    Header set Cache-Control "public, no-cache" env=lcafe_managed_menu
    Header set Cache-Control "public, max-age=31536000, immutable" env=lcafe_managed_media
  </IfModule>
</IfModule>

# Legacy stable-name helper, if served by an older host layout, must also
# revalidate rather than being pinned in a browser cache.
<FilesMatch "^image-slot\.js$">
  <IfModule mod_expires.c>
    ExpiresByType application/javascript "access plus 0 seconds"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# image-slot.js fetches this on every page load; without an explicit type some
# hosts serve dotfiles as octet-stream.
<Files ".image-slots.state.json">
  ForceType application/json
</Files>
