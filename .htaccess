# ال کافه — static site. Apache/LiteSpeed shared hosting.

# One origin. The certificate covers the apex, www and mail, and both hostnames
# resolve, so without this the same page answers on four addresses. The
# <link rel=canonical> in each page keeps search engines pointed at one of them
# and does nothing for the visitor: over plaintext the phone number and the map
# link travel unencrypted and the browser labels the page "not secure".
#
# Two conditions, not one. Some shared hosts terminate TLS at a proxy and hand
# the request to Apache with %{HTTPS} unset, where a scheme-only test redirects
# an already-secure request back to itself forever. If the proxy says it was
# https, believe it and stop. Deliberately no HSTS: a redirect loop is a bad
# hour, a redirect loop pinned into every visitor's browser is a bad month.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://lcafe-esf.ir%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.lcafe-esf\.ir$ [NC]
  RewriteRule ^ https://lcafe-esf.ir%{REQUEST_URI} [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

DirectoryIndex index.html

# The site ships no directory listings.
Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Fonts, images and the vendored React build are content-addressed by name
  # and never change in place, so they can be cached hard.
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # The pages themselves are what a redeploy changes; keep them short.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# image-slot.js is the exception to the month above, and the reason the rule
# reads "content-addressed by name": this one keeps its name and changes in
# place. A month of caching therefore pins every returning visitor to whichever
# copy they happened to fetch first - a fix to this file would not reach them
# until the cache aged out. Revalidating costs a 304 and no body.
# ExpiresByType (not ExpiresDefault) because a by-type rule outranks a default
# one, so it takes a by-type rule in this narrower context to override the one
# above it.
<FilesMatch "^image-slot\.js$">
  <IfModule mod_expires.c>
    ExpiresByType application/javascript "access plus 0 seconds"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# image-slot.js fetches this on every page load; without an explicit type some
# hosts serve dotfiles as octet-stream.
<Files ".image-slots.state.json">
  ForceType application/json
</Files>
