# Local tooling and generated working state, not part of the site.
.claude/
graphify-out/
.thumbnail
node_modules/
dist/
*.log
~$*.xlsx
.DS_Store

# Unused source photo, 3.5 MB, referenced by no page.
uploads/IMG_7751.jpeg

# Python bytecode from the packaging, deployment, export, and image utilities.
__pycache__/

# Upload archive, rebuilt by package.py from files already tracked here.
lcafe-site.zip

# The price sheet, rebuilt by menu_xlsx.py from menu.json - same rule as the zip
# above. Two reasons beyond that one: an .xlsx is a zip container, so every
# regeneration is a wholly new 20 KB blob in history that git cannot diff, and a
# tracked copy reads as a file worth editing in place when it is not - the next
# run overwrites whatever was typed into it. The route back into the site is
# menu.json, by hand, which is what menu_xlsx.py's own guide sheet says.
menu-products.xlsx

# Host credentials. .deploy.ini.example is the tracked template; the real file
# holds the FTP password and must never be committed. deploy.py checks this on
# every run rather than trusting the line above.
.deploy.ini

# Which file contents deploy.py last put on the host. Local bookkeeping, and
# per-machine: another clone has not uploaded anything yet.
.deploy-state.json
