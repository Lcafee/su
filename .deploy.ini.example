# Copy this file to .deploy.ini and fill it from the approved private operator
# record. .deploy.ini is gitignored and deploy.py refuses to run if Git tracks
# it. Never place a real hostname, account name, credential, or host path in
# this tracked template.

[host]
host = REPLACE_ME
user = REPLACE_ME
password = REPLACE_ME

# Directory as seen after login. Use "." for an account scoped directly to the
# site root; otherwise copy the operator-approved relative directory into the
# ignored local file. deploy.py confirms the target before any upload.
directory = .

# Explicit FTPS upgrades the control connection to TLS.
port = 21

# Keep certificate verification enabled. Any exception belongs in the private
# operator record and requires a separate security decision.
verify = yes
