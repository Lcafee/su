[Unit]
Description=L Cafe Main Site API
After=network.target
ConditionPathExists=/srv/lcafe-site/current/server-node/src/server.mjs

[Service]
Type=simple
User=lcafe-site
Group=lcafe-site
WorkingDirectory=/srv/lcafe-site/current/server-node
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
EnvironmentFile=/etc/lcafe-site/site.env
ExecStart=/usr/bin/node /srv/lcafe-site/current/server-node/src/server.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
UMask=0027

StateDirectory=lcafe-site
RuntimeDirectory=lcafe-site
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/lcafe-site /run/lcafe-site
TasksMax=128
MemoryHigh=384M
MemoryMax=640M
CPUQuota=100%
CPUWeight=50
IOWeight=50

[Install]
WantedBy=multi-user.target
